#!/usr/bin/env bash
# AppRun - glass-widget @VERSION@ (payload: @PAYLOAD_KIND@)
#
# Generated by packaging/linux/build_appimage.sh. Do not edit inside the
# AppImage; edit packaging/linux/AppRun.in instead.
set -euo pipefail

HERE="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
PAYLOAD_KIND="@PAYLOAD_KIND@"

# A desktop launcher can start us with an environment that has neither HOME nor
# XDG_DATA_HOME; under `set -u` that would abort with "unbound variable"
# instead of saying anything useful.
: "${HOME:=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6)}"
: "${HOME:=/tmp}"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/glass-widget"
mkdir -p "$DATA_HOME"

# Ship the offline offset table next to whatever we execute, the same way the
# Windows drop does (offsets_live.cpp looks for it in the exe's directory).
if [[ ! -f "$DATA_HOME/offsets_fallback.json" ]] \
   || [[ "$HERE/usr/share/glass-widget/offsets_fallback.json" -nt "$DATA_HOME/offsets_fallback.json" ]]; then
  cp -f "$HERE/usr/share/glass-widget/offsets_fallback.json" "$DATA_HOME/offsets_fallback.json" 2>/dev/null || true
fi

die() { printf '\033[31mglass-widget:\033[0m %s\n' "$*" >&2; exit 1; }

if [[ "$PAYLOAD_KIND" == "native" ]]; then
  cd "$DATA_HOME"
  exec "$HERE/usr/bin/glass-widget" "$@"
fi

# ----------------------------------------------------------------- Wine run --
WINE_BIN="${GLASS_WIDGET_WINE:-}"
if [[ -z "$WINE_BIN" ]]; then
  for c in wine wine64 wine-stable wine-staging; do
    if command -v "$c" >/dev/null 2>&1; then WINE_BIN="$(command -v "$c")"; break; fi
  done
fi
[[ -n "$WINE_BIN" ]] || die "Wine not found. Install wine (64-bit), or set GLASS_WIDGET_WINE=/path/to/wine.
            glass-widget has no native Linux build yet: the AppImage carries the
            Windows binary and runs it against the same Wine prefix style Roblox uses.
              Fedora/RHEL  sudo dnf install wine
              Debian/Ubuntu sudo apt install wine64
              Arch          sudo pacman -S wine"

# Wayland-only session with no XWayland: Wine's own Wayland driver is still
# experimental and an overlay that reads another window's geometry needs the X
# server Roblox itself is running under. Say that out loud rather than letting
# wine fail with "could not load winex11.drv".
if [[ -n "${WAYLAND_DISPLAY:-}" && -z "${DISPLAY:-}" && -z "${GLASS_WIDGET_ALLOW_WAYLAND:-}" ]]; then
  printf '\033[33mglass-widget:\033[0m Wayland session without XWayland (DISPLAY is unset).\n' >&2
  printf '            Wine is being asked to use its experimental Wayland driver; if the\n' >&2
  printf '            overlay never appears, install XWayland and retry.\n' >&2
  printf '            Set GLASS_WIDGET_ALLOW_WAYLAND=1 to silence this.\n' >&2
fi

export WINEPREFIX="${GLASS_WIDGET_WINEPREFIX:-$DATA_HOME/wineprefix}"
export WINEARCH=win64
export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-mscoree,mshtml=}"
export WINEDEBUG="${WINEDEBUG:--all}"

# system.reg only exists once wineboot has finished. Testing for the directory
# alone meant one interrupted first run left a permanently empty prefix that
# every later run skipped bootstrapping.
if [[ ! -f "$WINEPREFIX/system.reg" ]]; then
  printf 'glass-widget: creating Wine prefix at %s (first run, takes a moment)\n' "$WINEPREFIX"
  mkdir -p "$WINEPREFIX"
  WINEBOOT="${WINE_BIN%/*}/wineboot"
  if [[ -x "$WINEBOOT" ]]; then "$WINEBOOT" -u >/dev/null 2>&1 || true
  else "$WINE_BIN" wineboot -u >/dev/null 2>&1 || true; fi
  [[ -f "$WINEPREFIX/system.reg" ]] || \
    printf '\033[33mglass-widget:\033[0m wineboot did not finish initialising %s - continuing anyway\n' "$WINEPREFIX" >&2
fi

# Run from the data dir so imgui.ini, configs and the offset cache land in a
# writable, persistent place rather than inside the read-only mount.
cp -f "$HERE/usr/bin/glass-widget.exe" "$DATA_HOME/glass-widget.exe" 2>/dev/null || true
cd "$DATA_HOME"
exec "$WINE_BIN" "$DATA_HOME/glass-widget.exe" "$@"
